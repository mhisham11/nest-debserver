{
  "default_mode": "mention",
  "hackclub": {
    "base_url": "https://ai.hackclub.com/proxy/v1",
    "request_timeout_seconds": 60,
    "image_endpoint": "/images/generations"
  },
  "models": {
    "mention": ["anthropic/claude-haiku-5.5", "google/gemma-4-26b-a4b-it", "google/gemma-3-27b-it"],
    "chat": ["ganthropic/claude-haiku-5.5", "google/gemma-3-27b-it"],
    "vision": [],
    "low_budget": ["google/gemma-4-26b-a4b-it", "google/gemma-3-27b-it"],
    "image": ["google/gemini-3.1-flash-lite-image", "google/gemini-2.5-flash-image"]
  },
  "chat_mode": {
    "chance": 0.1,
    "channel_cooldown_seconds": 1
  },
  "context": {
    "messages": 64,
    "max_chars_per_message": 1000
  },
  "budget": {
    "daily_token_threshold": 500000,
    "timezone": "UTC",
    "image_token_cost": 2000
  },
  "triggers": {
    "search": ["search for"],
    "image": ["generate an image"]
  },
  "search": {
    "searxng_url": "http://searxng:8080",
    "max_results": 5,
    "timeout_seconds": 10,
    "max_snippet_chars": 300
  },
  "limits": {
    "max_output_tokens": 800,
    "max_images_per_message": 4,
    "max_image_bytes": 8388608,
    "user_cooldown_seconds": 3,
    "max_instruction_chars": 4000,
    "max_concurrent_requests": 4
  }
}
